#!/usr/bin/env node
/**
 * Launcher for the native devctl binary. The real binary ships in a
 * platform-specific package installed as an optionalDependency
 * (the esbuild/swc distribution pattern).
 */
'use strict'

const {spawnSync} = require('child_process')

const PLATFORM_PACKAGES = {
  'darwin arm64': '@maktouch/devctl-darwin-arm64',
  'darwin x64': '@maktouch/devctl-darwin-x64',
  'linux arm64': '@maktouch/devctl-linux-arm64',
  'linux x64': '@maktouch/devctl-linux-x64',
}

const key = `${process.platform} ${process.arch}`
const pkg = PLATFORM_PACKAGES[key]

if (!pkg) {
  console.error(`devctl: unsupported platform: ${key}`)
  process.exit(1)
}

let binary
try {
  binary = require.resolve(`${pkg}/bin/devctl`)
} catch {
  console.error(
    `devctl: the platform package ${pkg} is missing.\n` +
      'It is installed automatically as an optionalDependency; reinstall devctl ' +
      'and make sure optional dependencies are not disabled (--no-optional).'
  )
  process.exit(1)
}

const result = spawnSync(binary, process.argv.slice(2), {stdio: 'inherit'})

if (result.error) {
  console.error(`devctl: failed to run ${binary}: ${result.error.message}`)
  process.exit(1)
}

if (result.signal) {
  process.kill(process.pid, result.signal)
}

process.exit(result.status ?? 1)
